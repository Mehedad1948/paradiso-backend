<%- include('partials/header', { title: 'You are invited to a room', preheader: inviterUsername + ' has invited you to join a room on Paradiso', headerImageUrl: locals.headerImageUrl }) %>
                <p style="margin:0 0 6px;font-size:14px;letter-spacing:3px;text-transform:uppercase;color:#b08d57;text-align:center;">You&rsquo;re invited</p>
                <h1 style="margin:0 0 24px;font-weight:600;font-size:28px;line-height:1.3;color:#141a2b;text-align:center;">A seat has been saved for you</h1>
                <p style="margin:0 0 16px;">Hello,</p>
                <p style="margin:0 0 32px;">
                  <strong style="color:#141a2b;"><%= inviterUsername %></strong> has invited you to
                  join a room on Paradiso &mdash; a place to watch, discuss and
                  share the films you love, together.
                </p>
                <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 28px;">
                  <tr>
                    <td align="center" bgcolor="#141a2b" style="background-color:#141a2b;border-radius:2px;">
                      <a href="<%= invitationUrl %>" style="display:inline-block;padding:15px 40px;font-family:Georgia,'Times New Roman',serif;font-size:16px;letter-spacing:2px;text-transform:uppercase;color:#ffffff;text-decoration:none;">Join the room</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:0 0 8px;font-size:14px;color:#6b6a63;text-align:center;">
                  Button not working? Copy this link into your browser:
                </p>
                <p style="margin:0 0 20px;font-size:13px;color:#6b6a63;text-align:center;word-break:break-all;">
                  <a href="<%= invitationUrl %>" style="color:#8a6d3b;"><%= invitationUrl %></a>
                </p>
                <p style="margin:0 0 16px;font-size:15px;color:#6b6a63;text-align:center;">
                  Weren&rsquo;t expecting this? You can safely ignore this email.
                </p>
<%- include('partials/footer', { email: email }) %>
