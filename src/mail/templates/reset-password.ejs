<%- include('partials/header', { title: 'Reset your password', preheader: 'Your Paradiso password reset code is ' + code, headerImageUrl: locals.headerImageUrl }) %>
                <p style="margin:0 0 6px;font-size:14px;letter-spacing:3px;text-transform:uppercase;color:#b08d57;text-align:center;">Account security</p>
                <h1 style="margin:0 0 24px;font-weight:600;font-size:28px;line-height:1.3;color:#141a2b;text-align:center;">Reset your password</h1>
                <p style="margin:0 0 16px;">Dear <%= name %>,</p>
                <p style="margin:0 0 28px;">
                  We received a request to reset the password for your Paradiso
                  account. Enter the code below in the app to choose a new one.
                </p>
                <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 28px;">
                  <tr>
                    <td align="center" bgcolor="#f7f3ec" style="background-color:#f7f3ec;border:1px solid #e4dccf;border-radius:4px;padding:20px 36px;">
                      <span class="code" style="font-family:Georgia,'Times New Roman',serif;font-size:36px;font-weight:bold;letter-spacing:12px;color:#141a2b;padding-left:12px;"><%= code %></span>
                    </td>
                  </tr>
                </table>
                <p style="margin:0 0 16px;font-size:15px;color:#6b6a63;text-align:center;">
                  This code expires shortly. If you didn&rsquo;t request a reset, you can safely ignore this email &mdash; your password will remain unchanged.
                </p>
<%- include('partials/footer', { email: email }) %>
